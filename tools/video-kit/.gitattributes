# Line endings for the kit. These scripts run under bash on Linux and under Git Bash on the Dell.
# A CRLF checkout breaks a shell script, so every text file here is LF whatever core.autocrlf says.
* text=auto eol=lf
*.sh text eol=lf
*.py text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.svg text eol=lf

# Font files and their licences are stored exactly as released.
fonts/** -text
*.ttf binary
*.woff2 binary
*.wav binary
*.png binary
*.mp4 binary
