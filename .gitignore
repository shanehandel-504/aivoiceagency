.env

# Build scratch + backups — Run-4 near-miss guard: never let voice-stack backups,
# python caches, or transient build dirs get swept into a commit (secret risk).
__pycache__/
*.bak
*.backup
.ava_build_tmp/
voice-stack/**

# RUN 2: the WF-RATE / WF-ANI / WF-COMMIT shared secret. The test harnesses read it
# from here; it lives in the n8n Variable RATE_SHARED_SECRET and must never be
# committed (§ 9). It was untracked-but-unignored until now — one `git add` away
# from landing in history.
automation/rate-engine/rate_secret.txt
**/rate_secret.txt

# RUN S2 — loadout guard audit log. Local session trace, not repo content.
.claude/hooks/loadout-guard.log

# AIC RUN 13 · parity snapshots are ~28MB each and fully regenerable from the
# tree they describe (node tools/aic-run13-parity.mjs snap <label>). The DIFF
# reports beside them are the evidence and they are committed; the raw frames
# are not.
audits/run13/parity/

# RUN A · INVISIBLE TRUTH LAYER — regenerable audit inputs, not evidence.
# The DERIVED medians (audits/run-a/lh/before.json, after.json) are committed
# because they are the run's proof; the ~12MB of raw Lighthouse reports behind
# them are not, and neither is the 1.5MB schema.org vocabulary, which
# `python tools/validate_jsonld.py --fetch` pulls on demand.
audits/run-a/lh/before/
audits/run-a/lh/after/
audits/run-a/schemaorg-current-https.jsonld
