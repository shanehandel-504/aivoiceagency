    {
      "id": "e84a0599-4768-482c-84a6-485c822bf3b1",
      "name": "IndexNow Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        110
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// SEO-RECOVERY v1 · Oct 17 2026. The IndexNow key lives here, once, as this\n// workflow's variable. It is public by design (served at https://<host>/<key>.txt)\n// and it travels in the POST body, never in a node URL.\n// STAGE: 'sink-fail' | 'sink-ok' | 'live'. Only 'live' talks to IndexNow and Slack.\nconst STAGE = 'live';\nconst KEY = '69c6723b4b145a13877f1c954bdb0e09';\nconst SINK = 'https://circulant.app.n8n.cloud/webhook/zz-sink-retell-test';\nconst endpoint = STAGE === 'live' ? 'https://api.indexnow.org/indexnow'\n  : STAGE === 'sink-ok' ? SINK : SINK + '/indexnow-fail-probe';\nconst alertUrl = STAGE === 'live' ? 'https://slack.com/api/chat.postMessage' : SINK;\nreturn ['aivoiceagency.ai', 'aichauffeur.ai'].map((host) => ({ json: {\n  stage: STAGE, host, key: KEY, endpoint, alertUrl,\n  sitemap: 'https://' + host + '/sitemap.xml',\n  keyLocation: 'https://' + host + '/' + KEY + '.txt',\n} }));"
      }
    },
    {
      "id": "fb24f571-5ceb-4d51-b5bc-1489312ea51f",
      "name": "Fetch Sitemap",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        480,
        110
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $json.sitemap }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text",
              "outputPropertyName": "xml"
            }
          },
          "timeout": 20000
        }
      }
    },
    {
      "id": "114a069d-1114-4840-b27f-4a29ebedd56d",
      "name": "Build Submission",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        110
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// One IndexNow body per host: every <loc> in that host's sitemap that belongs\n// to the host (IndexNow answers 422 to a foreign URL) and is not a private\n// path. No URL global in this sandbox, so hosts are read with a regex.\nconst cfg = $('IndexNow Config').item.json;\nconst xml = String($json.xml || '');\nconst locs = [...xml.matchAll(/<loc>\\s*([^<\\s]+)\\s*<\\/loc>/g)].map((m) => m[1].replace(/&amp;/g, '&'));\nconst own = locs.filter((u) => {\n  const m = u.match(/^https:\\/\\/([^\\/?#]+)(\\/[^?#]*)?/);\n  return m && m[1] === cfg.host && !/^\\/(trip|hq|reports)(\\/|$)/i.test(m[2] || '/');\n});\nif (!own.length) throw new Error('IndexNow ' + cfg.host + ': the sitemap gave no URLs for this host');\nreturn { json: { host: cfg.host, key: cfg.key, keyLocation: cfg.keyLocation, endpoint: cfg.endpoint, alertUrl: cfg.alertUrl, stage: cfg.stage, urlList: own, count: own.length } };"
      }
    },
